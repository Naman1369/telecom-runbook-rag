{"id": "ax74-bgp-soft", "product": "AX-9000", "version": "7.4", "question": "BGP peer 10.0.0.2 is stuck in Idle after we fixed the fibre. How do I reset the session without dropping routes?", "expect_status": "answered", "expect_sources": ["aurora-networks/AX-9000/7.4/troubleshooting-runbook.md::RB-101"], "expect_command": "clear ip bgp 10.0.0.2 soft"}
{"id": "ax81-bgp-soft", "product": "AX-9000", "version": "8.1", "question": "BGP peer 10.0.0.2 is stuck in Idle after we fixed the fibre. How do I reset the session without dropping routes?", "expect_status": "answered", "expect_sources": ["aurora-networks/AX-9000/8.1/troubleshooting-runbook.md::RB-101"], "expect_command": "reset bgp neighbor 10.0.0.2 soft", "forbid_command": "clear ip bgp"}

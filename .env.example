# Copy this file to .env and fill in your own values. Never commit .env.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models. gemini-2.5-* is closed to new keys; list what your key can use with:
#   python -c "from google import genai; import os; [print(m.name) for m in genai.Client(api_key=os.environ['GEMINI_API_KEY']).models.list()]"
CHAT_MODEL=gemini-3.5-flash-lite
# Tried in order when the primary model is overloaded (503) or rate-limited (429)
CHAT_FALLBACK_MODELS=gemini-3.1-flash-lite
# Optional thinking level for Gemini 3.x ("low", "high"); leave empty for the model default
THINKING_LEVEL=
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Embedding provider: "gemini" (default) or "local" (offline hashing embedder, for tests/demos without a key)
EMBED_PROVIDER=gemini

# Retrieval
TOP_K=5
# Minimum cosine similarity for a chunk to count as relevant; below this the app answers "not found".
# Calibrated on gemini-embedding-001: answerable questions score >= 0.69, out-of-scope <= 0.62.
RELEVANCE_THRESHOLD=0.65

# Chunking (approximate tokens)
CHUNK_TOKENS=350
CHUNK_OVERLAP_TOKENS=50

# Generation
TEMPERATURE=0.1
MAX_OUTPUT_TOKENS=1024
MAX_CONTEXT_TOKENS=6000
